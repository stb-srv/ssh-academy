{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"], "env": ["BETTER_AUTH_*", "DATABASE_URL", "POCKET_ID_*", "NEXT_PUBLIC_*", "APP_URL"] },
    "lint": {},
    "typecheck": { "dependsOn": ["^build"] },
    "test": {},
    "dev": { "cache": false, "persistent": true }
  }
}
