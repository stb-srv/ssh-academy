# ---------------------------------------------------------------------------
# SSH-Academy Konfiguration. Kopieren nach .env und anpassen.
# ---------------------------------------------------------------------------

# Öffentliche Adresse, unter der die Plattform erreichbar ist (ohne / am Ende).
# Wichtig für Passkeys und Pocket ID: muss exakt der Adresse im Browser entsprechen.
APP_URL=https://ssh.example.de
APP_NAME=SSH-Academy

# Wie Caddy erreichbar ist (siehe infra/Caddyfile): Domain oder :80 (hinter anderem Reverse Proxy)
SITE_ADDRESS=ssh.example.de
# Nur im Heimnetz ohne öffentliche Domain: local_certs (Caddy stellt eigene Zertifikate aus)
CADDY_GLOBAL_OPTIONS=
# Ports auf dem Host (Standard 80/443)
HTTP_PORT=80
HTTPS_PORT=443

# Zufällige Geheimnisse erzeugen mit: openssl rand -hex 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# Registrierung: open (jeder) oder closed (nur der erste Nutzer als Admin, sonst nur Pocket ID)
REGISTRATION_MODE=closed
# Login mit E-Mail und Passwort erlauben (false = nur Pocket ID)
LOCAL_LOGIN_ENABLED=true
# Passwörter gegen bekannte Datenlecks prüfen (braucht Zugriff auf api.pwnedpasswords.com)
PASSWORD_BREACH_CHECK=true

# E-Mail-Versand (Bestätigung, Passwort vergessen). Ohne SMTP landen Mails im Container-Log
# und E-Mail-Adressen müssen nicht bestätigt werden.
# Beispiel: smtps://benutzer:passwort@smtp.example.de:465
SMTP_URL=
MAIL_FROM=SSH-Academy <noreply@example.de>

# --- Pocket ID (optional) --------------------------------------------------
# In Pocket ID: OIDC-Client anlegen, Callback-URL: <APP_URL>/api/auth/callback/pocket-id
POCKET_ID_URL=
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=
POCKET_ID_DISPLAY_NAME=Pocket ID
# Beim ersten Pocket-ID-Login automatisch ein Konto anlegen
POCKET_ID_AUTO_PROVISION=true
# Nur diese Pocket-ID-Gruppen dürfen sich anmelden (kommagetrennt, leer = alle)
POCKET_ID_ALLOWED_GROUPS=
# Bestehende lokale Konten automatisch per E-Mail verknüpfen (unsicherer, nur wenn Pocket ID die einzige Quelle ist)
POCKET_ID_AUTO_LINK_BY_EMAIL=false
# Höchstdauer einer Pocket-ID-Sitzung in Stunden
POCKET_ID_MAX_SESSION_HOURS=12
